{
  "name": "explosive-shinobi-arena",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.18",
    "@mui/material": "^5.15.14",
    "@react-three/fiber": "^8.15.16",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.160.0",
    "ws": "^8.18.3"
  },
  "scripts": {
    "start": "vite",
    "server": "npm run server:build && npm run server:start",
    "server:build": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --external:ws --outfile=server-dist/index.mjs",
    "server:start": "node server-dist/index.mjs",
    "build": "vite build",
    "lint": "eslint src server --ext .ts,.tsx",
    "test": "vitest run --coverage",
    "test:e2e": "npm run build && npm run server:build && playwright test",
    "preview": "vite preview"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.160.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^27.0.1",
    "typescript": "^4.9.5",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
